{
	email {$ADMIN_EMAIL}
}

(production_app) {
	encode gzip zstd

	handle_path /mobile/android/* {
		root * /srv/android-releases
		header Content-Type application/vnd.android.package-archive
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_path /api/* {
		reverse_proxy server:3000
	}

	handle /download/android {
		reverse_proxy server:3000
	}

	handle {
		reverse_proxy web:8080
	}

	log {
		output stdout
		format console
	}
}

{$APP_DOMAIN}, {$LEGACY_APP_DOMAIN} {
	import production_app
}

{$WWW_APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} 308
}

{$DEV_APP_DOMAIN} {
	encode gzip zstd

	handle_path /api/* {
		reverse_proxy server-dev:3000
	}

	handle {
		reverse_proxy web-dev:8080
	}

	log {
		output stdout
		format console
	}
}
